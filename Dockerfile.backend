FROM python:3.11-slim

# Install SWI-Prolog, system dependencies + Playwright deps
RUN apt-get update && apt-get install -y \
    swi-prolog \
    build-essential \
    # Playwright system dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Capa 1: torch CPU-only (pesado, se cachea si no cambia)
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.3.1+cpu

# Capa 2: resto de dependencias
COPY requirements.txt .
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

# Capa 3: Playwright + browser
RUN apt-get update && apt-get install -y \
    fonts-unifont \
    fonts-liberation \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/* \
    && playwright install chromium \
    && playwright install-deps chromium || true

# Copy source code
COPY src/ ./src/

# Default environment variables
ENV PYTHONPATH=src/
ENV CSV_PATH=src/data/steam_rpg_games.csv
ENV PARAMETERS_PATH=src/knowledge/parameters.json

EXPOSE 8000

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]